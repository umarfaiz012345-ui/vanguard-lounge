# ==============================================================================
# VANGUARD LOUNGE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Hosting / Runtime
PORT=3000
APP_URL=http://localhost:3000

# Session HMAC signing secret (auto-generated in memory if left empty)
SESSION_SECRET=your_long_random_session_secret_here

# Administrator one-time setup passcode (optional - required if setting up additional admins)
ADMIN_PASSCODE=

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================

# Server-Side Only (Strictly Private - NEVER expose in client bundles or public APIs)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_secret_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_anon_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Client-Side (Public - Vite injects VITE_ prefixed variables into the frontend build)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_anon_key_here
